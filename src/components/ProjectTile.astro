---
// A project card on the /projects page.
//   default:    image on top, fixed size, so every card in the grid matches
//   highlight:  a wide card with the image beside the text (desktop)
// The whole card opens the project page; the GitHub and video icons
// open their links directly.
import type { CollectionEntry } from "astro:content";
import StatusBadge from "./StatusBadge.astro";

interface Props {
  project: CollectionEntry<"projects">;
  highlight?: boolean;
}

const { project, highlight = false } = Astro.props;
const { title, description, category, tags, image, github, video, status } = project.data;
const href = `/projects/${project.id}`;
const shownTags = tags.slice(0, highlight ? 6 : 4);
const extraTags = tags.length - shownTags.length;
---

<article
  class:list={[
    "group relative flex overflow-hidden rounded-xl border border-border bg-surface transition hover:-translate-y-0.5 hover:border-accent hover:shadow-md",
    highlight ? "flex-col md:col-span-2 md:flex-row lg:col-span-3" : "flex-col",
  ]}
>
  <!-- Image (shown whole, never cropped) or a placeholder -->
  <div
    class:list={[
      "relative shrink-0 border-border bg-surface-alt",
      highlight
        ? "aspect-video border-b md:aspect-auto md:min-h-[320px] md:w-1/2 md:border-b-0 md:border-r"
        : "aspect-video border-b",
    ]}
  >
    {image ? (
      <img
        src={image}
        alt=""
        loading={highlight ? "eager" : "lazy"}
        class="absolute inset-0 h-full w-full object-contain p-4"
      />
    ) : (
      <div class="absolute inset-0 grid place-items-center p-6" aria-hidden="true">
        <div class="project-placeholder absolute inset-0 opacity-60"></div>
        <span class="relative rounded-md border border-border bg-surface px-3 py-1.5 text-center font-mono text-xs tracking-widest text-muted">
          {category.toUpperCase()}
        </span>
      </div>
    )}
  </div>

  <!-- Text -->
  <div class:list={["flex flex-1 flex-col", highlight ? "p-6 md:p-10" : "p-6"]}>
    <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2">
      {highlight && (
        <span class="rounded-full bg-accent px-2.5 py-0.5 font-mono text-[11px] tracking-widest text-on-accent">
          HIGHLIGHTED
        </span>
      )}
      <p class="font-mono text-xs uppercase tracking-wider text-accent">{category}</p>
      <StatusBadge status={status} />
    </div>

    <h2 class:list={["font-bold text-heading transition group-hover:text-accent", highlight ? "mb-4 text-3xl md:text-4xl" : "mb-3 text-xl"]}>
      <!-- This link covers the whole card -->
      <a href={href} class="after:absolute after:inset-0 after:content-['']">
        {title}
      </a>
    </h2>

    <p class:list={["leading-relaxed text-body", highlight ? "mb-6 text-lg" : "mb-5 line-clamp-3 text-sm"]}>
      {description}
    </p>

    <div class="mb-5 flex flex-wrap gap-2">
      {shownTags.map((tag) => (
        <span class="rounded-md bg-surface-alt px-2.5 py-1 font-mono text-xs text-muted">{tag}</span>
      ))}
      {extraTags > 0 && (
        <span class="rounded-md px-1.5 py-1 font-mono text-xs text-muted">+{extraTags}</span>
      )}
    </div>

    <!-- Footer: pushed to the bottom so every card lines up -->
    <div class="mt-auto flex items-center justify-between border-t border-border pt-4">
      <span class="text-sm font-semibold text-accent">
        View details <span class="inline-block transition group-hover:translate-x-1" aria-hidden="true">→</span>
      </span>

      <div class="relative z-10 flex items-center gap-3">
        {github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${title} on GitHub`}
            title="GitHub"
            class="text-muted transition hover:text-accent"
          >
            <svg class="h-5 w-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
            </svg>
          </a>
        )}
        {video && (
          <a
            href={video}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${title} demo video`}
            title="Demo video"
            class="text-muted transition hover:text-accent"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z" />
            </svg>
          </a>
        )}
      </div>
    </div>
  </div>
</article>

<style>
  /* Subtle circuit-like grid for projects without an image */
  .project-placeholder {
    background-image:
      linear-gradient(var(--site-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--site-border) 1px, transparent 1px);
    background-size: 24px 24px;
  }
</style>

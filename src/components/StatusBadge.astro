---
// "In progress" badge for projects with `status: in-progress`.
interface Props {
  status?: "in-progress";
  class?: string;
}

const { status, class: className = "" } = Astro.props;
---

{status === "in-progress" && (
  <span
    class:list={[
      "inline-flex items-center gap-1.5 rounded-full border border-amber-300 bg-amber-50 px-2.5 py-0.5 text-xs font-medium text-amber-800",
      className,
    ]}
  >
    <span class="h-1.5 w-1.5 rounded-full bg-amber-500" aria-hidden="true"></span>
    In progress
  </span>
)}

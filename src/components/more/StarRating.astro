---
// Shows a rating out of 5 stars, with half stars.
interface Props {
  rating: number;
  size?: "sm" | "md" | "lg";
}

const { rating, size = "sm" } = Astro.props;
const stars = [1, 2, 3, 4, 5].map((n) =>
  rating >= n ? "full" : rating >= n - 0.5 ? "half" : "empty",
);
const sizeClass = size === "lg" ? "h-7 w-7" : size === "md" ? "h-5 w-5" : "h-3.5 w-3.5";
const path =
  "M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z";
---

<span class="inline-flex items-center gap-0.5 text-amber-600" role="img" aria-label={`${rating} out of 5 stars`}>
  {stars.map((kind, i) => (
    <svg class={sizeClass} viewBox="0 0 24 24" aria-hidden="true">
      {kind === "half" && (
        <defs>
          <linearGradient id={`half-${i}`}>
            <stop offset="50%" stop-color="currentColor" />
            <stop offset="50%" stop-color="transparent" />
          </linearGradient>
        </defs>
      )}
      <path
        d={path}
        fill={kind === "full" ? "currentColor" : kind === "half" ? `url(#half-${i})` : "none"}
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"
      />
    </svg>
  ))}
</span>

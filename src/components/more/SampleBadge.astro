---
// Small label that marks placeholder content (items with `sample: true`).
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center rounded-md bg-amber-100 px-2 py-0.5 font-mono text-[10px] font-semibold tracking-widest text-amber-800 ring-1 ring-amber-300",
    className,
  ]}
>
  SAMPLE
</span>

---
// `display: stack` — one card for a post with several photos.
// Looks like a small deck; swipe (phone) or use the arrows (desktop)
// to flip through the photos. Clicking a photo opens the post.
import { Image } from "astro:assets";
import CardMeta from "./CardMeta.astro";
import SampleBadge from "./SampleBadge.astro";
import { getPhotos, type MoreEntry, type MoreSectionKey } from "../../lib/more";

interface Props {
  entry: MoreEntry;
  section: MoreSectionKey;
}

const { entry, section } = Astro.props;
const data = entry.data as MoreEntry["data"] & { kind?: string };
const href = `/more/${section}/${entry.id}`;
const photos = getPhotos(entry);
const first = photos[0].src;
---

<div
  data-collage-card
  data-post={entry.id}
  data-stack
  data-kind={data.kind ?? ""}
  class="group relative mb-5 break-inside-avoid pt-2.5"
>
  <!-- The two "cards behind" that make it look like a deck -->
  <div class="absolute inset-x-4 top-0 bottom-3 rounded-xl border border-border bg-surface-alt" aria-hidden="true"></div>
  <div class="absolute inset-x-2 top-1 bottom-1.5 rounded-xl border border-border bg-surface" aria-hidden="true"></div>

  <div class="relative overflow-hidden rounded-xl border border-border bg-surface transition group-hover:border-accent group-hover:shadow-md">
    <div class="relative">
      <div
        data-track
        class="flex snap-x snap-mandatory overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        style={`aspect-ratio: ${first.width} / ${first.height}`}
      >
        {photos.map((photo, i) => (
          <a href={href} class="h-full w-full shrink-0 snap-start" tabindex={i === 0 ? undefined : -1}>
            <Image
              src={photo.src}
              alt={photo.caption ?? `${data.title}, photo ${i + 1}`}
              widths={[320, 480, 640]}
              sizes="(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw"
              loading={i === 0 ? "lazy" : "lazy"}
              class="block h-full w-full object-cover"
            />
          </a>
        ))}
      </div>

      {data.sample && <SampleBadge class="absolute left-2.5 top-2.5" />}

      <span
        data-counter
        class="pointer-events-none absolute right-2.5 top-2.5 rounded-full bg-black/60 px-2 py-0.5 font-mono text-[11px] text-white"
      >
        1 / {photos.length}
      </span>

      <button type="button" data-prev aria-label="Previous photo" class="stack-arrow left-2">‹</button>
      <button type="button" data-next aria-label="Next photo" class="stack-arrow right-2">›</button>

      <!-- Dots -->
      <div class="pointer-events-none absolute inset-x-0 bottom-2 flex justify-center gap-1.5">
        {photos.map((_, i) => (
          <span data-dot data-active={i === 0 ? "" : undefined} class="stack-dot"></span>
        ))}
      </div>
    </div>

    <a href={href} class="block">
      <CardMeta entry={entry} section={section} photoCount={photos.length} />
    </a>
  </div>
</div>

<style>
  .stack-dot {
    height: 0.375rem;
    width: 0.375rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.55);
    box-shadow: 0 0 2px rgb(0 0 0 / 0.5);
  }
  .stack-dot[data-active] {
    background: white;
  }

  .stack-arrow {
    position: absolute;
    top: 50%;
    display: none;
    height: 2rem;
    width: 2rem;
    place-items: center;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.9);
    color: var(--site-heading);
    font-size: 1.25rem;
    line-height: 1;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.25);
    opacity: 0;
    transform: translateY(-50%);
    transition: opacity 150ms;
  }

  /* Arrows only on devices with a mouse; phones swipe instead */
  @media (hover: hover) {
    .stack-arrow {
      display: grid;
    }
    [data-stack]:hover .stack-arrow,
    .stack-arrow:focus-visible {
      opacity: 1;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-stack]").forEach((stack) => {
    const track = stack.querySelector<HTMLElement>("[data-track]")!;
    const counter = stack.querySelector<HTMLElement>("[data-counter]")!;
    const dots = stack.querySelectorAll<HTMLElement>("[data-dot]");
    const total = dots.length;

    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (index: number) => {
      const target = (index + total) % total; // wraps around at the ends
      track.scrollTo({ left: target * track.clientWidth, behavior: "smooth" });
    };

    stack.querySelector("[data-prev]")?.addEventListener("click", () => go(current() - 1));
    stack.querySelector("[data-next]")?.addEventListener("click", () => go(current() + 1));

    track.addEventListener(
      "scroll",
      () => {
        const i = current();
        counter.textContent = `${i + 1} / ${total}`;
        dots.forEach((dot, d) => dot.toggleAttribute("data-active", d === i));
      },
      { passive: true },
    );
  });
</script>

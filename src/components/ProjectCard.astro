---
// Featured project card on the home page. Compact on phones and tablets
// (where cards sit in a sideways swipe row), full size on desktop.
import StatusBadge from "./StatusBadge.astro";

interface Props {
  title: string;
  category: string;
  description: string;
  tags: string[];
  link: string;
  image?: string;
  status?: "in-progress";
}

const { title, category, description, tags, link, image, status } = Astro.props;
---

<a
  href={link}
  class="group flex flex-col rounded-xl border border-border bg-surface p-4 transition hover:border-accent lg:block lg:p-8"
>

<div class="flex items-start gap-4">
  <div class="min-w-0 flex-1">
  <div class="mb-1.5 flex flex-wrap items-center gap-2 lg:mb-4 lg:gap-3">
    <p class="font-mono text-[10px] uppercase tracking-wider text-accent lg:text-xs">
      {category}
    </p>
    <StatusBadge status={status} />
  </div>

  <h3 class="mb-1 line-clamp-1 text-base font-bold text-heading transition group-hover:text-accent lg:mb-4 lg:line-clamp-none lg:text-2xl">
    {title} ↗
  </h3>

  <p class="mb-3 line-clamp-2 text-[13px] leading-snug text-body lg:mb-6 lg:line-clamp-none lg:text-base lg:leading-relaxed">
    {description}
  </p>
</div>

  <!-- Small project thumbnail -->
  {image && (
    <img
      src={image}
      alt={`${title} thumbnail`}
      loading="lazy"
      class="hidden h-20 w-20 shrink-0 rounded-lg border border-border bg-surface object-contain p-1 lg:block"
    />
  )}

</div>
  <div class="mt-auto flex max-h-[1.4rem] flex-wrap gap-1.5 overflow-hidden lg:max-h-none lg:gap-2">
    {tags.map((tag) => (
      <span class="rounded-md bg-surface-alt px-2 py-0.5 font-mono text-[11px] text-muted lg:px-3 lg:py-1 lg:text-xs">
        {tag}
      </span>
    ))}
  </div>
</a>

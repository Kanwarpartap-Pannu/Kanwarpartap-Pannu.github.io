

---
interface Props {
  title: string;
  category: string;
  description: string;
  tags: string[];
  link: string;
}

const { title, category, description, tags, link } = Astro.props;
---

<a
  href={link}
  class="group block rounded-xl border border-slate-800 bg-slate-900 p-8 transition hover:border-cyan-500/60"
>
  <p class="mb-4 font-mono text-xs uppercase tracking-wider text-cyan-400">
    {category}
  </p>

  <h3 class="mb-4 text-2xl font-bold transition group-hover:text-cyan-400">
    {title} ↗
  </h3>

  <p class="mb-6 leading-relaxed text-slate-400">
    {description}
  </p>

  <div class="flex flex-wrap gap-2">
    {tags.map((tag) => (
      <span class="rounded-md bg-slate-800 px-3 py-1 font-mono text-xs text-slate-300">
        {tag}
      </span>
    ))}
  </div>
</a>


---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import ProjectGallery from "../../components/ProjectGallery.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const galleries = {
  "zerocost-llc": [
    {
      src: "/images/zerocost-llc/zcllc_component_diagram.jpg",
      alt: "ZeroCost-LLC component architecture",
    },
    {
      src: "/images/zerocost-llc/flow_chart.jpg",
      alt: "Cache request and relocation dataflow",
    },
    {
      src: "/images/zerocost-llc/state_diagram.jpg",
      alt: "Cache controller state diagram",
    },
  ],
  "riscv-cpu": [
    {
      src: "/images/riscv-cpu/core_datapath.png",
      alt: "CPU core datapath",
    },
  ],
};

const gallery = galleries[project.id] ?? [];
---


<Layout
  title={`${project.data.title} | Engineering Portfolio`}
  description={project.data.description}
>
  <main class="mx-auto max-w-4xl px-6 py-10">

    <!-- Back navigation -->
    <a
      href="/#projects"
      class="mb-10 inline-block text-sm text-muted transition hover:text-accent"
    >
      ← Back to Projects
    </a>

    <!-- Project header -->
    <header class="mb-4">
      <p class="mb-4 font-mono text-sm text-accent">
        {project.data.category}
      </p>

      <h1 class="mb-6 text-5xl font-bold tracking-tight text-heading">
        {project.data.title}
      </h1>

      <p class="mb-6 text-xl leading-relaxed text-body">
        {project.data.description}
      </p>

      <!-- Technology tags -->
      <div class="flex flex-wrap gap-2">
        {project.data.tags.map((tag) => (
          <span
            class="rounded-md bg-surface-alt px-3 py-1 font-mono text-xs text-muted"
          >
            {tag}
          </span>
        ))}
      </div>

      <!-- GitHub documentation -->
      {project.data.github && (
        <a
          href={project.data.github}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex items-center gap-3 rounded-lg bg-accent px-6 py-3 font-semibold text-on-accent transition hover:bg-accent-hover"
        >
          View Technical Documentation on GitHub
          <span aria-hidden="true">↗</span>
        </a>
      )}
    </header>

    <!-- Project content -->
    <article class="project-content border-t border-border pt-0">

      <ProjectGallery images={gallery} />

      <Content />

      <!-- Bottom GitHub CTA -->
      {project.data.github && (
        <div
          class="mt-16 rounded-xl border border-border bg-surface p-8 text-center"
        >
          <h2 class="mb-3 text-2xl font-bold text-heading">
            Explore the Implementation
          </h2>

          <p class="mx-auto mb-6 max-w-xl text-body">
            Interested in the architecture, RTL implementation,
            verification environment, and design decisions?
            Explore the complete project documentation and source code.
          </p>

          <a
            href={project.data.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex rounded-lg border border-accent px-6 py-3 font-semibold text-accent transition hover:bg-accent hover:text-on-accent"
          >
            Explore on GitHub ↗
          </a>
        </div>
      )}

    </article>
  </main>
</Layout>

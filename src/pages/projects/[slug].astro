

---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout
  title={`${project.data.title} | Engineering Portfolio`}
  description={project.data.description}
>
  <main class="mx-auto max-w-4xl px-6 py-20">

    <a
      href="/#projects"
      class="mb-10 inline-block text-sm text-slate-400 transition hover:text-cyan-400"
    >
      ← Back to Projects
    </a>

    <header class="mb-12">
      <p class="mb-4 font-mono text-sm text-cyan-400">
        {project.data.category}
      </p>

      <h1 class="mb-6 text-5xl font-bold tracking-tight">
        {project.data.title}
      </h1>

      <p class="mb-6 text-xl leading-relaxed text-slate-400">
        {project.data.description}
      </p>

      <div class="flex flex-wrap gap-2">
        {project.data.tags.map((tag) => (
          <span class="rounded-md bg-slate-800 px-3 py-1 font-mono text-xs text-slate-300">
            {tag}
          </span>
        ))}
      </div>

      {project.data.github && (
        <a
          href={project.data.github}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-block text-cyan-400 hover:underline"
        >
          View Source on GitHub ↗
        </a>
      )}
    </header>

    <article class="project-content border-t border-slate-800 pt-10">
      <Content />
    </article>

  </main>
</Layout>


---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort(
    (a, b) =>
      b.data.date.getTime() - a.data.date.getTime()
  );
---

<Layout
  title="Engineering Portfolio | Kanwar Pannu"
  description="Computer engineering portfolio specializing in digital design, computer architecture, and AI hardware acceleration."
>
  <main>

    <!-- Hero Section -->
    <section class="mx-auto max-w-6xl px-6 py-28">
      <p class="mb-5 font-mono text-sm tracking-wide text-accent">
        COMPUTER ENGINEER / DIGITAL HARDWARE
      </p>

      <h1 class="max-w-4xl text-5xl font-bold leading-tight tracking-tight text-heading md:text-7xl">
        Building efficient computing systems <span class="text-accent">from RTL to silicon.</span>
      </h1>

      <p class="mt-8 max-w-2xl text-lg leading-relaxed text-body">
        I'm a computer engineering graduate specializing in digital design,
        computer architecture, and hardware acceleration for AI. My work
        spans processors, memory systems, and custom accelerators.
      </p>

      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="#projects"
          class="rounded-lg bg-accent px-6 py-3 font-semibold text-on-accent transition hover:bg-accent-hover"
        >
          Explore Projects →
        </a>

        <a
          href="/resume"
          class="rounded-lg border border-border px-6 py-3 font-semibold text-heading transition hover:border-accent hover:text-accent"
        >
          View Resume
        </a>
      </div>
    </section>

    <!-- Featured Projects -->
    <section
      id="projects"
      class="border-t border-border bg-surface-alt"
    >
      <div class="mx-auto max-w-6xl px-6 py-24">
        <div class="mb-12">
          <p class="mb-3 font-mono text-sm text-accent">
            SELECTED WORK
          </p>

          <h2 class="text-4xl font-bold text-heading">
            Featured Projects
          </h2>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
          {projects.map((project) => (
            <ProjectCard
              title={project.data.title}
              category={project.data.category}
              description={project.data.description}
              tags={project.data.tags}
              link={`/projects/${project.id}`}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section
      id="about"
      class="mx-auto max-w-6xl px-6 py-24"
    >
      <p class="mb-3 font-mono text-sm text-accent">
        ABOUT ME
      </p>

      <h2 class="mb-6 text-4xl font-bold text-heading">
        Engineering at every level.
      </h2>

      <p class="max-w-3xl text-lg leading-relaxed text-body">
        My interests lie at the intersection of computer architecture,
        digital circuit design, and high-performance computing. I enjoy
        translating architectural ideas into working RTL, verifying their
        correctness, and exploring their physical implementation.
      </p>
    </section>

  </main>
</Layout>

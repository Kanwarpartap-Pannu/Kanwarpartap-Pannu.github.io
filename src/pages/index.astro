
---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionTitle from "../components/SectionTitle.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort(
    (a, b) =>
      b.data.date.getTime() - a.data.date.getTime()
  );
---

<Layout
  title="Engineering Portfolio | Kanwar Pannu"
  description="Computer engineering portfolio specializing in digital design, computer architecture, and AI hardware acceleration."
>
  <main>
<!-- Hero Section -->
<section class="mx-auto max-w-6xl px-6 py-24">
  <div class="grid items-center gap-12 md:grid-cols-[minmax(0,0.9fr)_280px]">

    <!-- Left: Your existing introduction -->
    <div>
      <!-- Keep your existing hero heading,
           description, and buttons here -->
      <p class="mb-5 font-mono text-sm tracking-wide text-accent">
        COMPUTER ENGINEER / DIGITAL HARDWARE
      </p>

<div class="flex items-center gap-4 md:block">

  <h1 class="shrink-0 text-4xl font-bold tracking-tight text-heading md:text-6xl">
    Hi,
    <span class="block">
      I'm Kanwar 
    </span>
  </h1>

  <div class="flex min-w-0 flex-1 justify-center md:hidden">
    <img
      src="/images/grad_shot.jpg"
      alt="Kanwar Pannu"
      class="h-20 w-20 rounded-full border-2 border-accent object-cover object-top"
    />
  </div>

</div>

<p class="mt-6 max-w-xl text-lg leading-relaxed text-body">
  I'm a recent computer engineering graduate interested in computer architecture,
  digital design, and building hardware from the ground up.
</p>

<p class="mt-4 max-w-xl text-lg leading-relaxed text-body">
  I enjoy turning ideas into working systems, from RTL to silicon.
</p>

<p class="mt-6 inline-flex items-start gap-2.5 rounded-lg border border-border bg-surface px-4 py-2.5 text-sm text-heading">
  <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-emerald-600" aria-hidden="true"></span>
  <span>
    Open to entry-level <span class="font-semibold">RTL design, ASIC, and design verification</span> roles in Canada and the US.
  </span>
</p>

      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a
          href="#projects"
          class="rounded-lg bg-accent px-6 py-3 font-semibold text-on-accent transition hover:bg-accent-hover"
        >
          Explore Projects →
        </a>

        <a
          href="/resume"
          class="rounded-lg border border-border px-6 py-3 font-semibold text-heading transition hover:border-accent hover:text-accent"
        >
          View Resume
        </a>

        <SocialLinks variant="hero" />
      </div>
    </div>



<!-- Portrait with CPU die frame -->
<div class="relative mx-auto hidden w-full max-w-[320px] md:block">

  <!-- CPU die: larger than portrait -->
  <div class="absolute -inset-10 overflow-hidden rounded-2xl border border-border">
    <img
      src="/images/cpu_die.jpg"
      alt=""
      class="h-full w-full object-cover"
    />
  </div>

  <!-- Portrait: stays the same size -->
  <img
    src="/images/grad_shot.jpg"
    alt="Portrait of Kanwar Pannu"
    class="relative z-10 h-75 w-full rounded-3xl object-cover object-top"
  />

</div>

  </div>
</section>



<!-- Featured Projects + About Me -->
<div class="mx-auto grid max-w-6xl gap-16 px-6 py-2 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-12">

  <!-- LEFT: Featured Projects
       On large screens this column takes the height of About Me
       (h-0 + min-h-full) and the cards scroll inside it. -->
  <section id="projects" class="min-w-0 lg:flex lg:h-0 lg:min-h-full lg:flex-col">
    <SectionTitle number="01" title="Featured Projects" />

    <div class="projects-scroll mt-8 grid gap-6 lg:min-h-0 lg:flex-1 lg:overflow-y-auto lg:px-1 lg:pb-10 lg:pt-1">
      <!-- Keep your existing ProjectCard components here -->
	 <div class="grid gap-6 md:grid-cols-1">
          {projects.map((project) => (
            <ProjectCard
              title={project.data.title}
              category={project.data.category}
              description={project.data.description}
              tags={project.data.tags}
              link={`/projects/${project.id}`}
              image={project.data.image}
              status={project.data.status}
            />
          ))}
        </div>
    </div>

    <a
      href="/projects"
      class="mt-6 inline-flex font-semibold text-accent transition hover:text-accent-hover"
    >
      View all projects →
    </a>
  </section>

  <!-- RIGHT: About Me -->
  <section id="about" class="min-w-0">
    <SectionTitle number="02" title="About Me" />

    <div class="mt-8">
      <!-- Keep your existing About Me text here -->
<h2 class="mb-6 text-4xl font-bold text-heading">
        Engineering at every level.
      </h2>


<div class="space-y-5 text-body leading-7">
  <p>
    I'm drawn to the layer where software meets silicon: how an architectural idea becomes RTL, how that RTL is proven correct, and how it finally turns into gates and layout. My main interests are <span class="font-semibold text-heading">computer architecture and digital design</span>.
  </p>

  <p>
    I started in research, spending two years in York University's neuromorphics group designing spiking neural network algorithms for low-power AI. That work led me to hardware, where I've since built a pipelined RISC-V core, a predictable last-level cache from a research paper, and a spiking CNN accelerator, and helped a team take a TPU from RTL to GDS.
  </p>

  <p>
    Across these projects, I've learned that a design is only as good as its verification. I write golden models, self-checking testbenches, and co-simulation flows alongside the RTL, not after it.
  </p>

  <p>
    Outside engineering, I enjoy music, playing guitar, drawing, and reading.
  </p>

  <div class="flex flex-wrap gap-x-6 gap-y-2 pt-1">
    <a
      href="/resume"
      class="font-semibold text-accent transition hover:text-accent-hover"
    >
      View My Resume ↗
    </a>

    <a
      href="/more"
      class="font-semibold text-accent transition hover:text-accent-hover"
    >
      More About Me ↗
    </a>
  </div>

</div>
    </div>
  </section>

</div>

  </main>
</Layout>


---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort(
    (a, b) =>
      b.data.date.getTime() - a.data.date.getTime()
  );
---

<Layout
  title="Engineering Portfolio | Kanwar Pannu"
  description="Computer engineering portfolio specializing in digital design, computer architecture, and AI hardware acceleration."
>
  <main>
<!-- Hero Section -->
<section class="mx-auto max-w-6xl px-6 py-24">
  <div class="grid items-center gap-12 md:grid-cols-[minmax(0,0.9fr)_280px]">

    <!-- Left: Your existing introduction -->
    <div>
      <!-- Keep your existing hero heading,
           description, and buttons here -->
      <p class="mb-5 font-mono text-sm tracking-wide text-accent">
        COMPUTER ENGINEER / DIGITAL HARDWARE
      </p>

<div class="flex items-center gap-4 md:block">

  <h1 class="shrink-0 text-4xl font-bold tracking-tight text-heading md:text-6xl">
    Hi,
    <span class="block">
      I'm Kanwar 
    </span>
  </h1>

  <div class="flex min-w-0 flex-1 justify-center md:hidden">
    <img
      src="/images/grad_shot.jpg"
      alt="Kanwar Pannu"
      class="h-20 w-20 rounded-full border-2 border-accent object-cover object-top"
    />
  </div>

</div>

<p class="mt-6 max-w-xl text-lg leading-relaxed text-body">
  I'm a recent computer engineering graduate interested in computer architecture,
  digital design, and building hardware from the ground up.
</p>

<p class="mt-4 max-w-xl text-lg leading-relaxed text-body">
  I enjoy turning ideas into working systems, from RTL to silicon.
</p>

      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="#projects"
          class="rounded-lg bg-accent px-6 py-3 font-semibold text-on-accent transition hover:bg-accent-hover"
        >
          Explore Projects →
        </a>

        <a
          href="/resume"
          class="rounded-lg border border-border px-6 py-3 font-semibold text-heading transition hover:border-accent hover:text-accent"
        >
          View Resume
        </a>
      </div>
    </div>



<!-- Portrait with CPU die frame -->
<div class="relative mx-auto hidden w-full max-w-[320px] md:block">

  <!-- CPU die: larger than portrait -->
  <div class="absolute -inset-10 overflow-hidden rounded-2xl border border-border">
    <img
      src="/images/cpu_die.jpg"
      alt=""
      class="h-full w-full object-cover"
    />
  </div>

  <!-- Portrait: stays the same size -->
  <img
    src="/images/grad_shot.jpg"
    alt="Portrait of Kanwar Pannu"
    class="relative z-10 h-75 w-full rounded-3xl object-cover object-top"
  />

</div>

  </div>
</section>



<!-- Featured Projects + About Me -->
<div class="mx-auto grid max-w-6xl gap-16 px-6 py-2 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-12">

  <!-- LEFT: Featured Projects -->
  <section id="projects" class="min-w-0">
    <SectionTitle number="01" title="Featured Projects" />

    <div class="mt-8 grid gap-6">
      <!-- Keep your existing ProjectCard components here -->
	 <div class="grid gap-6 md:grid-cols-1">
          {projects.map((project) => (
            <ProjectCard
              title={project.data.title}
              category={project.data.category}
              description={project.data.description}
              tags={project.data.tags}
              link={`/projects/${project.id}`}
            />
          ))}
        </div>
    </div>
  </section>

  <!-- RIGHT: About Me -->
  <section id="about" class="min-w-0 lg:sticky lg:top-28 lg:self-start">
    <SectionTitle number="02" title="About Me" />

    <div class="mt-8">
      <!-- Keep your existing About Me text here -->
<h2 class="mb-6 text-4xl font-bold text-heading">
        Engineering at every level.
      </h2>


<div class="space-y-5 text-body leading-7">
  <p>
    My journey in computer engineering has taken me through a range of
    areas, from researching novel AI learning algorithms to designing
    and implementing hardware systems. While I've enjoyed exploring
    different fields, my main interests lie in <span class="font-semibold text-heading">
      computer architecture and digital design.
    </span>
  </p>

  <p>
    I've designed a RISC-V processor from scratch, implemented a
    research-based cache architecture in SystemVerilog to improve
    cache eviction efficiency, and developed a custom accelerator
    for a spiking neural network. I've also worked in a team to
    take a TPU design from RTL to physical layout and explored
    analog circuit design through an AI-powered EEG detection project.
  </p>

  <p>
    I enjoy understanding how computing systems work at every level,
    from architectural decisions down to the circuits that bring
    them to life.
  </p>

<p class="mt-5 leading-7 text-body">
  I encourage you to explore some of my featured projects to get a
  closer look at what I've been working on. Outside of engineering,
  I enjoy music, playing guitar, drawing, and reading. If you're
  curious about what keeps me busy beyond hardware, feel free to
  check out my & More page. Otherwise, take a look at my resume
  to learn more about my experience and technical background!
</p>

<div class="mt-6 flex flex-wrap gap-6">
  <a
    href="/more"
    class="font-semibold text-accent transition hover:text-accent-hover"
  >
    & More About Me ↗
  </a>

  <a
    href="/resume"
    class="font-semibold text-accent transition hover:text-accent-hover"
  >
    View My Resume ↗
  </a>
</div>

</div>
    </div>
  </section>

</div>

  </main>
</Layout>

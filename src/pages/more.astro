

---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="& More | Kanwar Pannu"
  description="A little more about my interests, hobbies, and life beyond engineering."
>
  <main class="mx-auto max-w-5xl px-6 py-20">

    <!-- Back navigation -->
    <a
      href="/#about"
      class="mb-16 inline-block text-sm text-muted transition hover:text-accent"
    >
      ← Back to About
    </a>

    <!-- Page heading -->
    <section class="mb-16">
      <p class="mb-5 font-mono text-sm tracking-wide text-accent">
        BEYOND ENGINEERING
      </p>

      <h1 class="mb-6 text-5xl font-bold tracking-tight text-heading md:text-7xl">
        & More<span class="text-accent">.</span>
      </h1>

      <p class="max-w-2xl text-lg leading-relaxed text-body">
        There's more to life than circuits and code.
        This is where I'll share some of my interests,
        hobbies, and things I'm exploring outside engineering.
      </p>
    </section>

    <!-- Coming soon -->
    <section class="rounded-xl border border-border bg-surface p-12 text-center md:p-20">
      <p class="mb-4 font-mono text-sm tracking-widest text-accent">
        A WORK IN PROGRESS
      </p>

      <h2 class="mb-4 text-3xl font-bold text-heading md:text-4xl">
        Coming Soon.
      </h2>

      <p class="mx-auto max-w-md leading-relaxed text-muted">
        A few more things about me are on their way.
        Check back later.
      </p>
    </section>

  </main>
</Layout>
